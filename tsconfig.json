{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7"
		],
		"paths": {
			"obsidian": [
				"./node_modules/obsidian"
			],
			"commons/*": [
				"../obsidian-commons/src/*/index.ts"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.mts"
	]
}
